{
	"name": "workspace",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "npm run test:unit",
		"test:unit": "vitest run --config vitest.unit.config.ts",
		"test:smoke": "npm test && npm run check && npm run build",
		"test:smoke:full": "npm run test:smoke && npm run build-storybook",
		"test:preview": "npm run build && node scripts/preview-smoke.mjs",
		"test:functional:preview": "npm run build && node scripts/functional-preview-smoke.mjs",
		"test:deployed": "node scripts/deployed-smoke.mjs",
		"test:deployed:local": "npm run build && node scripts/deployed-smoke-local.mjs",
		"test:release": "npm run test:smoke:full && npm run test:preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"hash:password": "node scripts/hash-password.mjs"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.0.1",
		"@cloudflare/workers-types": "^4.20260214.0",
		"@storybook/addon-a11y": "^10.2.8",
		"@storybook/addon-docs": "^10.2.8",
		"@storybook/addon-svelte-csf": "^5.0.11",
		"@storybook/addon-vitest": "^10.2.8",
		"@storybook/sveltekit": "^10.2.8",
		"@sveltejs/adapter-cloudflare": "^7.2.7",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.2.3",
		"@vitest/browser-playwright": "^4.0.18",
		"@vitest/coverage-v8": "^4.0.18",
		"fast-check": "^4.5.3",
		"playwright": "^1.58.2",
		"storybook": "^10.2.8",
		"svelte": "^5.53.6",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"wrangler": "^4.65.0"
	},
	"dependencies": {
		"isomorphic-dompurify": "^3.0.0-rc.2",
		"marked": "^17.0.2",
		"mermaid": "^11.12.2",
		"zod": "^4.3.6"
	}
}
