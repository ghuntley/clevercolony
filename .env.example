# Required: shared password hash for login
# Format: pbkdf2_sha256$<iterations>$<salt-base64url>$<digest-base64url>
APP_ACCESS_PASSWORD_HASH=pbkdf2_sha256$210000$REPLACE_SALT$REPLACE_DIGEST

# Required: HMAC secret for session cookie signing
APP_SESSION_SECRET=replace-with-long-random-secret

# Required for ZAI text/image requests
ZAI_API_KEY=

# Required for web search tool (Serper)
SERPER_API_KEY=

# Optional Cloudflare REST fallback values
CF_ACCOUNT_ID=
CF_API_TOKEN=
